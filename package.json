{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "description": "BIFROST - an open multi-spectral telemetry platform. Node hardware, grid database, discriminator, and documentation, versioned together.",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "yarn workspace @bifrost/web dev",
    "build": "yarn codegen && yarn workspace @bifrost/web build",
    "start": "yarn workspace @bifrost/web start",
    "lint": "yarn workspace @bifrost/web lint",
    "type-check": "yarn workspace @bifrost/web type-check",
    "codegen": "node tools/codegen.mjs",
    "check:drift": "node tools/check-drift.mjs",
    "db:seed": "node tools/seed.mjs",
    "check": "yarn check:drift && yarn type-check && yarn lint"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
