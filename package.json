{
  "name": "nband",
  "version": "0.1.0",
  "private": true,
  "description": "nband - open multi-spectral sensing platform for anomalous aerial phenomena. Node hardware, grid database, discriminator, and documentation, versioned together.",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @nband/web dev",
    "build": "yarn codegen && yarn workspace @nband/web build",
    "start": "yarn workspace @nband/web start",
    "lint": "yarn workspace @nband/web lint",
    "type-check": "yarn workspace @nband/web type-check",
    "codegen": "node tools/codegen.mjs && node tools/build-search-index.mjs",
    "check:drift": "node tools/check-drift.mjs",
    "check:parity": "node tools/check-parity.mjs",
    "check:links": "node tools/check-links.mjs",
    "fixtures": "python3 tools/gen-fixtures.py",
    "db:seed": "node tools/seed.mjs",
    "check": "make check",
    "check:fast": "make check-fast"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xaxis/nband.git"
  },
  "homepage": "https://nband.space",
  "bugs": {
    "url": "https://github.com/Xaxis/nband/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
