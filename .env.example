# BIFROST environment
# Copy to .env and fill in. Never commit .env.

# --- Supabase (grid database) ---
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only. It bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by migrations and the discriminator.
SUPABASE_DB_URL=

# --- Supabase management (provisioning only, not needed at runtime) ---
SUPABASE_TOKEN=

# --- Vercel (deploy only, not needed at runtime) ---
VERCEL_TOKEN=

# --- Resend (contact form + node-registration mail) ---
# The key must be allowed to send from RESEND_FROM_EMAIL's domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=bifrost@example.org
CONTACT_TO_EMAIL=

# --- Site ---
# Absolute origin, no trailing slash. Used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Telemetry feed source ---
# "mock"  - deterministic synthetic feed, no database required (default)
# "live"  - read from the Supabase grid tables
NEXT_PUBLIC_FEED_SOURCE=mock

# --- Node ingest ---
# Shared secret for the /api/grid/register enrollment handshake. Nodes exchange
# it once for a per-node key; it is never used to sign telemetry.
BIFROST_ENROLLMENT_SECRET=
